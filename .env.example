# ── MODEL TALK ── copy to .env.local and fill in what you have.
# You need at least ONE of the four LLM providers. Everything else is optional.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Any OpenAI-compatible endpoint: OpenRouter, Together, Groq, LM Studio, Ollama…
# e.g. COMPAT_BASE_URL=https://openrouter.ai/api/v1
COMPAT_BASE_URL=
COMPAT_API_KEY=

# ── VOX (spoken channel) ── optional.
# Browser voices need no key at all. These two unlock better ones.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── Community sharing ── optional.
# Set to "off" to hide SHARE TO COMMUNITY and disable the live ledger entirely.
# NEXT_PUBLIC_COMMUNITY=off
# Point the app at local Firebase emulators (pnpm emu) instead of production.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
